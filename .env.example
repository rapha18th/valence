# Local dev calls PubChem directly from the browser (works, permissive CORS).
# Leave this empty for `npm run dev`.
VITE_PUBCHEM_PROXY=

# Production builds use .env.production, which sets VITE_PUBCHEM_PROXY=/api/pug
# so requests route through the Vercel edge proxy (api/pug/[...path].ts):
# different egress IPs than the visitor, plus a 24h edge cache. To test the
# exact prod bundle locally against PubChem directly, override it:
#   VITE_PUBCHEM_PROXY= npm run build && npm run preview
